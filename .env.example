# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local dev: a local Postgres instance.
# Production: the Supabase project's connection string (Project Settings > Database).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- Admin auth -----------------------------------------------------------
ADMIN_SESSION_SECRET="<64 hex chars: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\">"
ADMIN_EMAIL="info@windycitylinen.com"
ADMIN_PASSWORD="<strong password for the first admin login>"

# --- Quote request / contact email --------------------------------------
QUOTE_INBOX="info@windycitylinen.com"
RESEND_API_KEY="<from resend.com; blank = log emails to console instead of sending>"
EMAIL_FROM="Windy City Linen <website@windycitylinen.com>"

# --- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.windycitylinen.com"

# --- AI (chatbot, My Inspirations mood board) -----------------------------
# From console.anthropic.com; blank = mocked responses so features are still
# testable in dev. Set for real before launch (see src/lib/ai/claude.ts).
ANTHROPIC_API_KEY=""
